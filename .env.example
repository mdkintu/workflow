# WorkFlow environment — LAN install defaults (docs/02-architecture.md §9.1).
# Copy to `.env` and fill in the secrets. Every host-specific value lives
# here, never in code (ADR-18). See deploy/vps.env.example for a public VPS.

# --- Caddy / TLS (Caddy reads these directly; Django never sees CADDY_TLS) ---
# The hostname Caddy serves. On a LAN this is resolved by the router's DNS.
SITE_HOST=localhost
# Absolute base URL: used for SMS links, QR codes and CSRF trusted origins.
SITE_URL=https://localhost
# Caddy's `tls` directive value: "internal" on a LAN (self-signed CA),
# or an email address for a public VPS (Let's Encrypt via ACME).
CADDY_TLS=internal
# Serve the /setup (CA install) page. true on a LAN, false on a public VPS.
CA_SETUP_PAGE_ENABLED=true

# --- Django ---
DJANGO_SETTINGS_MODULE=workflow.settings.prod
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=false
# Comma-separated. Must include SITE_HOST.
ALLOWED_HOSTS=localhost
# Defaults to SITE_URL when omitted. Leave commented out rather than blank:
# django-environ treats `KEY=` (empty) as "set to ''", not "unset".
# CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=31536000
# Trust Caddy's X-Forwarded-Proto header (Caddy terminates TLS in front of us).
TRUST_PROXY_HEADERS=true

# --- Database ---
# The password here MUST match POSTGRES_PASSWORD below — this is what the web/
# worker/beat containers use to reach `db`. (If you change one, change both.)
DATABASE_URL=postgres://workflow:change-me@db:5432/workflow
# Used by the `db` container itself (postgres:16 image).
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflow

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Defaults to REDIS_URL when omitted (see the CSRF_TRUSTED_ORIGINS note above).
# CELERY_BROKER_URL=

# --- Dev mode only (`make dev`; ignored by `make up`/the containers) ---
# `make dev` runs `db`/`redis` in Docker but Django/Celery/Tailwind natively
# in .venv (see CLAUDE.md "Commands"). These publish the containers' ports to
# 127.0.0.1 so the native processes can reach them; change them if 5432/6379
# are already taken on your machine. DATABASE_URL/REDIS_URL above are left
# untouched (still `db`/`redis`, still what `make up` and a VPS use) — the
# `dev-*` Makefile targets rewrite them to localhost via scripts/dev-env.sh.
# If 5432/6379 are already used by another Postgres/Redis on your machine
# (`docker compose up db redis` will fail with "address already in use"),
# pick different ports here, e.g. REDIS_PORT=16379.
DB_PORT=5432
REDIS_PORT=6379

# --- Media / static ---
# Paths inside the container.
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static
# Path Caddy uses for the protected-media internal redirect (docs/02 §7).
MEDIA_INTERNAL_PREFIX=/_protected/media/
# Serve photos via Caddy (X-Accel-Redirect). true behind Caddy (make up / a
# VPS). Dev mode (make dev) has no Caddy; scripts/dev-env.sh turns it off.
MEDIA_X_ACCEL=true

# --- SMS / WhatsApp (notifications/backends, ADR-10) ---
# "console" (dev/LAN demo, logs only) or "africastalking" (real SMS).
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Defaults to Africa's Talking's production messaging URL when omitted.
# AT_API_URL=
# Accept AT delivery-report callbacks. Needs a publicly reachable URL.
SMS_DELIVERY_WEBHOOK_ENABLED=false
# "none" until Q3 (WhatsApp) is answered.
WHATSAPP_BACKEND=none

# --- Compose-only (not read by Django) ---
HTTP_PORT=80
HTTPS_PORT=443
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
# Host path for scripts/backup.sh output.
BACKUP_DIR=./backups
APP_IMAGE=workflow:latest
