# WorkFlow environment — public VPS example (docs/02-architecture.md §9.1,
# §9.2 "Moving from LAN to a VPS"). Copy to `.env` on the VPS and fill in
# fresh secrets. Never copy the LAN `.env` verbatim.

# --- Caddy / TLS ---
SITE_HOST=app.example.ug
SITE_URL=https://app.example.ug
# An email address switches Caddy to ACME (Let's Encrypt/ZeroSSL) instead of
# its internal CA.
CADDY_TLS=ops@example.ug
# No LAN devices to onboard on a public host.
CA_SETUP_PAGE_ENABLED=false

# --- Django ---
DJANGO_SETTINGS_MODULE=workflow.settings.prod
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=false
ALLOWED_HOSTS=app.example.ug
# Defaults to SITE_URL when omitted. Leave commented out rather than blank:
# django-environ treats `KEY=` (empty) as "set to ''", not "unset".
# CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=31536000
TRUST_PROXY_HEADERS=true

# --- Database ---
# The password here MUST match POSTGRES_PASSWORD below (or point at a managed
# database instead — docs/02-architecture.md §9.1 — in which case POSTGRES_*
# below are unused and the `db` service can be removed from docker-compose.yml).
DATABASE_URL=postgres://workflow:change-me@db:5432/workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflow

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Defaults to REDIS_URL when omitted (see the CSRF_TRUSTED_ORIGINS note above).
# CELERY_BROKER_URL=

# --- Media / static ---
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static
MEDIA_INTERNAL_PREFIX=/_protected/media/
MEDIA_X_ACCEL=true

# --- SMS / WhatsApp ---
SMS_BACKEND=africastalking
AT_USERNAME=your-at-username
AT_API_KEY=change-me
AT_SENDER_ID=WorkFlow
# Defaults to Africa's Talking's production messaging URL when omitted.
# AT_API_URL=
# A public VPS can receive Africa's Talking delivery-report callbacks.
SMS_DELIVERY_WEBHOOK_ENABLED=true
WHATSAPP_BACKEND=none

# --- Compose-only ---
HTTP_PORT=80
HTTPS_PORT=443
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
BACKUP_DIR=/var/backups/workflow
APP_IMAGE=registry.example.ug/workflow:1.0.0
